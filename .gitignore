# Segredos: a senha do MySQL vive no .env, que NUNCA vai para o repositorio.
# O deploy tambem exclui o .env do rsync, entao o arquivo do servidor sobrevive.
.env
.env.*
!.env.example

# Build
bin/
obj/

# Visual Studio: indice de busca (*.vsidx), cache e configuracao local do IDE.
# Tudo regenerado sozinho ao abrir a solucao -- nunca vai para o repositorio.
.vs/

# Dump gerado pelo script de migracao do SQLite
dados-pizzaria-mysql.sql
