# =============================================================================
# ATENCAO: este .env e do ambiente do SERVIDOR (docker-compose.prod.yml).
#
# Para rodar na sua maquina voce NAO precisa de .env nenhum -- o
# docker-compose.yml da raiz ja sobe com credenciais de desenvolvimento:
#
#     docker compose up -d --build
#
# No servidor o arquivo e escrito pelo deploy a partir dos secrets do GitHub.
# Copie este modelo para .env so se for subir o ambiente de producao a mao.
# O .env nao vai para o git nem para o rsync do deploy.
#
# A porta 3306 do prod esta publicada na internet -- use senhas fortes de verdade.
# =============================================================================

MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=pizzaria
MYSQL_USER=pizzaria
MYSQL_PASSWORD=troque_esta_senha_do_app

# Reset diario dos dados de demonstracao
RESET_HORA=03:00
RESET_AO_SUBIR=false
TZ=America/Sao_Paulo
